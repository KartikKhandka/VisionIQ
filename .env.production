# Database
DATABASE_URL=postgresql://postgres:securepassword@db:5432/visioniq

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=production_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=https://visioniq.ai,https://api.visioniq.ai

# AWS
AWS_ACCESS_KEY_ID=your_prod_key
AWS_SECRET_ACCESS_KEY=your_prod_secret
AWS_REGION=us-east-1
AWS_BUCKET_NAME=visioniq-storage-prod
